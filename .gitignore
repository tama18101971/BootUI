# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
BootLoaderGUI.spec

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.exe

# Serena (agent tooling) local state
.serena/

# C/C++ language server (clangd) — machine-local state, never shared.
# clangd writes its background index to .cache/clangd/index/ (clangd 11+);
# clangd 9/10 used .clangd/index/. Both are transient and safe to delete.
# NOTE: the trailing slash matters — ".clangd/" ignores only a *directory*,
# so a shareable ".clangd" config *file* stays tracked for the whole team.
.cache/
.clangd/
# compile_commands.json embeds absolute per-machine paths; regenerate locally.
compile_commands.json

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db